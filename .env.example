NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PAYLOAD_SECRET=your-super-secret-key-min-32-chars-change-this

# Vercel Blob Storage
# Automatically set by Vercel when you add Blob storage to your project.
# For local development: copy the value from your Vercel project's env vars.
BLOB_READ_WRITE_TOKEN=vercelblob_rw_xxxxx

NEXT_PUBLIC_SERVER_URL=http://localhost:3000
